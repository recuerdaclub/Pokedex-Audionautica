{
  "identifier": "default",
  "description": "Default permissions for Audionáutica",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/**" },
        { "url": "https://*.github.com/**" }
      ]
    }
  ]
}
