{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audionautica",
  "version": "1.0.1",
  "identifier": "cl.audionautica.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audionautica",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Ableton Consolidate loop harvester",
    "longDescription": "Audionautica archives Ableton Consolidate loops into your local library and configured filesystem mirrors.",
    "category": "Music",
    "copyright": "Copyright © 2026 Audionautica",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
